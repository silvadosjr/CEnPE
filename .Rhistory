## Exploratory multiple-group analysis: GERES Mathematics
## 3PL model estimated with mirt and stabilizing item priors
## Groups: State (reference) versus Private
## Dependencies, if needed: install.packages(c("mirt", "ggplot2", "sn"))
## Outputs: RealDataAnalysis/Fit/GERES_StatePrivate_mirt/<grade-wave-sample>/
## ========================================================================
## Run from the repository root, or set IRT_TASK_ROOT.
if (.Platform$OS.type == "windows") {
invisible(Sys.setlocale("LC_ALL", "Portuguese_Brazil.utf8"))
}
project_root <- Sys.getenv("IRT_TASK_ROOT", unset = getwd())
library(mirt)
library(ggplot2)
library(sn)
## ========================================================================
## Analysis settings
## ========================================================================
## Actual MDB grade; the input RDS records the selected assessment wave.
## Prepared datasets: grade 1 / wave 2; grade 2 / wave 3;
## grade 3 / wave 4; grade 4 / wave 5. Includes easy and hard original forms.
grade <- 1L  # available: 1, 2, 3, 4
stopifnot(grade %in% 1:4)
## Full data are the default because the private group is smaller.
## If balancing is enabled, cap the requested size at the smaller group.
use_balanced_sample <- FALSE
n_per_group <- 500L
stratify_by_municipality <- TRUE
seed <- 20261017
quadrature_points <- 61L
max_em_cycles <- 2000L
convergence_tolerance <- 1e-4
calculate_SE <- TRUE
## Set TRUE only when an existing fit should be replaced.
overwrite_fit <- FALSE
## ========================================================================
## Paths
## ========================================================================
data_dir <- file.path(
project_root, "RealDataAnalysis",
"Large scale assessement in Brazil", "Projeto Geres"
)
input_file <- file.path(
data_dir,
paste0("math_state_vs_private_grade", grade, ".rds")
)
if (!file.exists(input_file)) {
stop("GERES response RDS not found: ", input_file)
}
