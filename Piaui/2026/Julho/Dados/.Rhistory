alpha <- 1 - conf
band_low <- apply(
sim_mat,
1,
quantile,
probs = alpha / 2,
na.rm = TRUE
)
band_high <- apply(
sim_mat,
1,
quantile,
probs = 1 - alpha / 2,
na.rm = TRUE
)
df <- tibble(
q_theo = q_theo,
x_ord = x_ord,
band_low = band_low,
band_high = band_high
)
if (is.null(subtitle)) {
subtitle <- paste0(
round(100 * conf, 1),
"% de bandas pontuais baseadas em ",
B,
" simulações normais"
)
}
p_qq <- ggplot(df, aes(x = q_theo, y = x_ord)) +
geom_ribbon(
aes(ymin = band_low, ymax = band_high),
alpha = 0.25
) +
geom_point(size = 1.6, alpha = 0.75) +
geom_abline(
intercept = intercept,
slope = slope,
linewidth = 0.7,
linetype = "dashed"
) +
labs(
title = title,
subtitle = subtitle,
x = xlab,
y = ylab
) +
theme_bw(base_size = 12)
return(p_qq)
}
# ============================================================
# Comparação: QQ-normal para Skew-t e Skew-slash
# ============================================================
compare_qqnorm <- function(
n = 1000,
mu = 0,
sigma2 = 1,
delta = -0.8,
nu = 5,
B = 1000,
conf = 0.95,
seed = 123
) {
set.seed(seed)
amos_ST <- ST_rng(
n = n,
mu = mu,
sigma2 = sigma2,
delta = delta,
nu = nu
)
amos_SSL <- SSL_rng(
n = n,
mu = mu,
sigma2 = sigma2,
delta = delta,
nu = nu
)
subtitle_text <- paste0(
"n = ", n,
", delta = ", delta,
", nu = ", nu
)
p_ST <- qqnorm_band(
x = amos_ST,
B = B,
conf = conf,
seed = seed + 1,
title = expression("QQ-normal plot: skew-" * t),
subtitle = subtitle_text
)
p_SSL <- qqnorm_band(
x = amos_SSL,
B = B,
conf = conf,
seed = seed + 2,
title = "QQ-normal plot: skew-slash",
subtitle = subtitle_text
)
p_final <- p_ST + p_SSL +
plot_annotation(
title = "Comparação com a distribuição normal",
subtitle = "Bandas simuladas sob normalidade"
)
output <- list(
data = tibble(
skew_t = amos_ST,
skew_slash = amos_SSL
),
plots = list(
skew_t = p_ST,
skew_slash = p_SSL,
combined = p_final
)
)
return(output)
}
