# ============================================================
# QQ-normal plots com bandas de confiança
# Comparação: Skew-t vs Skew-slash
# Parametrização em função de delta
# ============================================================
rm(list = ls(all = TRUE))
# ============================================================
# Pacotes
# ============================================================
library(sn)
library(tidyverse)
library(patchwork)
# ============================================================
# Conversão delta -> lambda
# ============================================================
delta_to_lambda <- function(delta) {
if (any(abs(delta) >= 1)) {
stop("delta deve pertencer ao intervalo aberto (-1, 1).")
}
delta / sqrt(1 - delta^2)
}
# ============================================================
# Gerador Skew-t centrado
# Parametrização por mu, sigma2, delta e nu
# ============================================================
ST_rng <- function(n = 1, mu = 0, sigma2 = 1, delta = 0, nu = 5) {
if (n <= 0) {
stop("ST_rng: n deve ser positivo.")
}
if (sigma2 <= 0) {
stop("ST_rng: sigma2 deve ser positivo.")
}
if (nu <= 2) {
stop("ST_rng: para variância finita, é necessário nu > 2.")
}
if (abs(delta) >= 1) {
stop("ST_rng: delta deve pertencer ao intervalo aberto (-1, 1).")
}
lambda <- delta_to_lambda(delta)
b_nu <- sqrt(nu / pi) *
exp(lgamma(0.5 * (nu - 1)) - lgamma(0.5 * nu))
mu1 <- b_nu * delta
mu2 <- (nu / (nu - 2)) - mu1^2
omega <- sqrt(sigma2 / mu2)
alfa <- mu - omega * mu1
g <- rgamma(
n = n,
shape = nu / 2,
rate  = nu / 2
)
y <- sn::rsn(
n = n,
xi = alfa,
omega = omega / sqrt(g),
alpha = lambda
)
return(y)
}
# ============================================================
# Gerador Skew-slash centrado
# Parametrização por mu, sigma2, delta e nu
# ============================================================
SSL_rng <- function(n = 1, mu = 0, sigma2 = 1, delta = 0, nu = 5) {
if (n <= 0) {
stop("SSL_rng: n deve ser positivo.")
}
if (sigma2 <= 0) {
stop("SSL_rng: sigma2 deve ser positivo.")
}
if (nu <= 2) {
stop("SSL_rng: para a parametrização centrada com variância finita, é necessário nu > 2.")
}
if (abs(delta) >= 1) {
stop("SSL_rng: delta deve pertencer ao intervalo aberto (-1, 1).")
}
lambda <- delta_to_lambda(delta)
b <- sqrt(2 / pi)
# Se W ~ Beta(nu, 1), então S = 1/W.
#
# E[S]  = nu / (nu - 1), nu > 1
# E[S²] = nu / (nu - 2), nu > 2
mu1 <- (nu / (nu - 1)) * b * delta
mu2 <- (nu / (nu - 2)) - mu1^2
omega <- sqrt(sigma2 / mu2)
alfa <- mu - omega * mu1
w <- rbeta(
n = n,
shape1 = nu,
shape2 = 1
)
z <- sn::rsn(
n = n,
xi = 0,
omega = 1,
alpha = lambda
)
y <- alfa + omega * (z / w)
return(y)
}
# ============================================================
# QQ-normal plot com bandas de confiança
# A banda é pontual e simulada sob normalidade.
# ============================================================
qqnorm_band <- function(
x,
B = 1000,
conf = 0.95,
seed = 123,
title = "QQ-normal plot com bandas de confiança",
subtitle = NULL,
xlab = "Quantis teóricos da normal padrão",
ylab = "Quantis amostrais"
) {
x <- x[is.finite(x)]
n <- length(x)
if (n < 5) {
stop("qqnorm_band: o vetor x deve conter pelo menos 5 observações finitas.")
}
if (B <= 0) {
stop("qqnorm_band: B deve ser positivo.")
}
if (conf <= 0 || conf >= 1) {
stop("qqnorm_band: conf deve pertencer ao intervalo (0, 1).")
}
set.seed(seed)
prob <- ppoints(n)
q_theo <- qnorm(prob)
x_ord <- sort(x)
qx <- quantile(
x,
probs = c(0.25, 0.75),
names = FALSE,
type = 7
)
qz <- qnorm(c(0.25, 0.75))
slope <- diff(qx) / diff(qz)
intercept <- qx[1] - slope * qz[1]
sim_mat <- replicate(B, {
sort(rnorm(n, mean = mean(x), sd = sd(x)))
})
alpha <- 1 - conf
band_low <- apply(
sim_mat,
1,
quantile,
probs = alpha / 2,
na.rm = TRUE
)
band_high <- apply(
sim_mat,
1,
quantile,
probs = 1 - alpha / 2,
na.rm = TRUE
)
df <- tibble(
q_theo = q_theo,
x_ord = x_ord,
band_low = band_low,
band_high = band_high
)
if (is.null(subtitle)) {
subtitle <- paste0(
round(100 * conf, 1),
"% de bandas pontuais baseadas em ",
B,
" simulações normais"
)
}
p_qq <- ggplot(df, aes(x = q_theo, y = x_ord)) +
geom_ribbon(
aes(ymin = band_low, ymax = band_high),
alpha = 0.25
) +
geom_point(size = 1.6, alpha = 0.75) +
geom_abline(
intercept = intercept,
slope = slope,
linewidth = 0.7,
linetype = "dashed"
) +
labs(
title = title,
subtitle = subtitle,
x = xlab,
y = ylab
) +
theme_bw(base_size = 12)
return(p_qq)
}
